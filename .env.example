# ── Ollama (local) ────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
GHOST_OLLAMA_HOST=http://localhost:11434
GHOST_MODEL=qwen2.5:7b

# ── Laya Ultrafast ───────────────────────────────────────────────────────────
DECISION_MODEL=laya
LAYA_MODEL=aac6fef/laya-typed-decisions-mlx
TEXT_MODEL_BASE_URL=http://localhost:11434/v1
TEXT_MODEL=qwen2.5:7b
TEXT_MODEL_API_KEY=none
TEXT_MODEL_REASONING=none

# ── Gemini API ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── TypeSafe Jev ──────────────────────────────────────────────────────────────
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_MODEL=jev-latest

# ── OpenRouter (for text generation) ─────────────────────────────────────────
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5

# ── Security ──────────────────────────────────────────────────────────────────
BROWSER_AGENTS_API_KEY=your_secret_api_key_here

# Bind to LAN interface (do NOT use 0.0.0.0 in production)
HOST=127.0.0.1
PORT=8900

# Rate limiting
RATE_LIMIT_PER_MINUTE=10

# Task limits
MAX_TIMEOUT=180
MAX_STEPS=10
MAX_GOAL_LENGTH=400

# Audit log
AUDIT_LOG=/tmp/browser-agents-audit.jsonl
